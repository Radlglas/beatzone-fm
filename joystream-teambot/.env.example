# ── Joystream FM Teambot ──────────────────────────────
BOT_TOKEN=dein-bot-token
CLIENT_ID=deine-application-id

# ── Team-Rollen ───────────────────────────────────────
# Wer darf die Team-Befehle nutzen? (mind. TEAM_ROLE_ID setzen)
TEAM_ROLE_ID=
LEITUNG_ROLE_ID=
AZUBI_ROLE_ID=

# ── Radio-Channels ────────────────────────────────────
# 📻 · sendeplan — hier postet /sendeplan posten den Wochenplan
SENDEPLAN_CHANNEL_ID=
# 🎶 · jetzt-läuft — hier meldet /onair Start & Ende einer Sendung
JETZT_LAEUFT_CHANNEL_ID=

# ── Team-Channels ─────────────────────────────────────
# 📣 · team-ankündigungen
TEAM_ANNOUNCE_CHANNEL_ID=
# 📅 · dienstplan — Abwesenheiten landen hier
DIENSTPLAN_CHANNEL_ID=
# 💡 · ideen
IDEEN_CHANNEL_ID=
# 🔧 · bug-meldungen
BUGS_CHANNEL_ID=
# 🤖 · bot-logs (optional)
BOT_LOG_CHANNEL_ID=

# ── Meeting-Channels ──────────────────────────────────
# 📖 · meeting-agenda — Meeting-Einladungen mit Zu-/Absage-Buttons
MEETING_AGENDA_CHANNEL_ID=
# 📝 · meeting-protokoll
MEETING_PROTOKOLL_CHANNEL_ID=

# ── Ausbildungs-Channels ──────────────────────────────
# 📄 · aufgaben — neue Azubi-Aufgaben
AUFGABEN_CHANNEL_ID=
# 📈 · fortschritt — erledigte Aufgaben
FORTSCHRITT_CHANNEL_ID=

# ── Team-Verwaltung ───────────────────────────────────
# 🛡️ Modlog-Channel — hier landen Warns, Kicks, Bans etc.
MODLOG_CHANNEL_ID=

# ── Web-Panel & API ───────────────────────────────────
# Login fürs Admin-Panel im Browser
PANEL_USER=admin
PANEL_PASSWORD=
# Öffentliche API für die Website an/aus (Standard: an)
WEB_ENABLE=true
# Port: auf dem Host setzt Pterodactyl SERVER_PORT automatisch.
# Nur für lokalen Test nötig:
WEB_PORT=3000
